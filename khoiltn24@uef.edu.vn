
import streamlit as st

# ==============================
# 1. CẤU HÌNH GIAO DIỆN
# ==============================

st.set_page_config(
    page_title="Công cụ tính lãi đơn và lãi kép",
    page_icon="💰",
    layout="centered"
)

st.title("💰 CÔNG CỤ TÍNH LÃI ĐƠN VÀ LÃI KÉP")

st.write(
    "Ứng dụng giúp khách hàng tính toán và so sánh "
    "số tiền nhận được theo hai phương pháp tính lãi."
)

st.divider()

# ==============================
# 2. NHẬP DỮ LIỆU
# ==============================

st.subheader("📌 Nhập thông tin khoản tiền gửi")

C = st.number_input(
    "Số tiền gốc (C) – Đồng",
    min_value=0,
    value=100000000,
    step=1000000,
    format="%d"
)

i_percent = st.number_input(
    "Lãi suất mỗi kỳ (i) – %",
    min_value=0.0,
    value=1.0,
    step=0.1,
    format="%.2f"
)

n = st.number_input(
    "Số kỳ gửi tiền (n)",
    min_value=0,
    value=3,
    step=1
)

# Chuyển lãi suất phần trăm sang số thập phân
i = i_percent / 100

# ==============================
# 3. TÍNH TOÁN
# ==============================

# Lãi đơn
An = C * (1 + i * n)

# Lãi kép
Bn = C * ((1 + i) ** n)

# Chênh lệch giữa hai phương pháp
chenh_lech = Bn - An

# ==============================
# 4. HIỂN THỊ KẾT QUẢ
# ==============================

st.divider()
st.subheader("📊 KẾT QUẢ TÍNH TOÁN")

col1, col2 = st.columns(2)

with col1:
    st.metric(
        label="Số tiền nhận được – Lãi đơn",
        value=f"{An:,.0f} đồng"
    )

with col2:
    st.metric(
        label="Số tiền nhận được – Lãi kép",
        value=f"{Bn:,.0f} đồng"
    )

st.divider()

st.subheader("📈 So sánh kết quả")

st.write(
    f"**Chênh lệch giữa lãi kép và lãi đơn:** "
    f"{chenh_lech:,.0f} đồng"
)

# Biểu đồ so sánh
st.bar_chart({
    "Số tiền nhận được (đồng)": {
        "Lãi đơn": An,
        "Lãi kép": Bn
    }
})

# ==============================
# 5. CÔNG THỨC TÍNH
# ==============================

with st.expander("Xem công thức tính toán"):

    st.markdown("""
    **1. Công thức lãi đơn:**

    \\[
    A_n = C(1 + i \\times n)
    \\]

    **2. Công thức lãi kép:**

    \\[
    B_n = C(1+i)^n
    \\]
    """)

    st.write(f"- Tiền gốc: {C:,.0f} đồng")
    st.write(f"- Lãi suất: {i_percent:.2f}%")
    st.write(f"- Số kỳ: {n}")

st.success("Hoàn tất tính toán!")
